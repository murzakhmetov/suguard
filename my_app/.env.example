# SuGuard build-time configuration template
#
# Copy to `.env` (gitignored) and fill in your keys, then build/run with:
#
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#
# Keys are compiled into the app via String.fromEnvironment (lib/config/env.dart).
# Any missing key compiles to an empty string: the app still builds, and the
# feature that needs it reports an error at request time.
#
# WARNING: anything compiled into a mobile/web build can be extracted from the
# binary. These keys are not secret once shipped; use a backend proxy for that.

# Resend API Key (Emergency email alerts)
RESEND_API_KEY=your_resend_api_key_here

# Groq API Key (AI Health Consultant + text food analysis - Llama 3.3 70B)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Food Photo Nutrition Analysis - Gemini 3.1 Flash-Lite)
GEMINI_API_KEY=your_gemini_api_key_here
